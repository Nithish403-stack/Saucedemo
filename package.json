{
  "name": "playwright-cucumber-saucedemo",
  "version": "1.0.0",
  "description": "Playwright automation project for saucedemo.com",
  "main": "index.js",
  "scripts": {
    "pretest": "powershell -Command \"if(Test-Path 'reports/playwright/screenshots'){Remove-Item -Recurse -Force reports/playwright/screenshots/*}; if(Test-Path 'reports/playwright/traces'){Remove-Item -Recurse -Force reports/playwright/traces/*}\"",
    "test": "cucumber-js && node scripts/generate-report.js",
    "report": "node scripts/generate-report.js",
    "test:headed": "cucumber-js --world-parameters headless=false && node scripts/generate-report.js",
    "test:env": "set TEST_ENV=stage&& cucumber-js && node scripts/generate-report.js"
  },
  "dependencies": {
    "@cucumber/cucumber": "^9.6.0",
    "@playwright/test": "^1.63.0",
    "cucumber-html-reporter": "^5.5.0",
    "dotenv": "^18.0.4",
    "playwright": "^1.40.0"
  },
  "devDependencies": {
    "fs-extra": "^11.1.1"
  }
}
